# ---------------------------------------------------------------------------
# Reference clone of the Pi agent harness.
#
# This is upstream code, not part of Kubic. It is checked out read-only as a
# reference for the Pi interfaces Kubic builds on. It is not built, linted,
# tested or modified by this repository, and it will be removed once Kubic no
# longer needs it as a reference.
# ---------------------------------------------------------------------------
/pi/

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.yarn/
.npm/
.pnpm-store/

# ---------------------------------------------------------------------------
# Build output and caches
# ---------------------------------------------------------------------------
dist/
build/
out/
coverage/
.nyc_output/
*.tsbuildinfo
.cache/
.turbo/
.parcel-cache/
.eslintcache
.biome/

# ---------------------------------------------------------------------------
# Agent tooling (worktrees, local settings) — never tracked
# ---------------------------------------------------------------------------
.claude/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Secrets and environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets/
credentials.json

# ---------------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
.tmp/
scratch/
*.local

# ---------------------------------------------------------------------------
# Mutation testing output — reports/ and Stryker working dirs are
# regenerated by `npm run test:mutation`, never committed.
# ---------------------------------------------------------------------------
reports/
.stryker-tmp/

# ---------------------------------------------------------------------------
# Kubic runtime state.
#
# `.kubic/` is a MIXED directory: config.toml + roles/*.md are committed
# (see `git ls-files .kubic`), everything below is per-run state. Only the
# runtime subpaths are ignored — never `.kubic/` itself, or the committed
# half would stop being trackable. `kubic run` writes the same rules into a
# user repo's local exclude file; scripts/runtime-exclude.test.mjs keeps
# the two lists in step.
# ---------------------------------------------------------------------------
.kubic/sessions/
.kubic/journal/
.kubic/artifacts/
.kubic/audit/

# ---------------------------------------------------------------------------
# Private agent instructions: the development process of the AI agents that
# build Kubic. Local only, deliberately not part of the released codebase
# (public files must not reference or depend on it).
# ---------------------------------------------------------------------------
AGENTS.md
