{
  // knip, pinned exactly in package.json. `npm run lint:dead` runs it in CI.
  // docs/contributing.md ("Dead-code gate") says what this gate does and does
  // not guarantee.
  "$schema": "https://unpkg.com/knip@6.38.0/schema.json",

  // An export that its own module uses is not reported. Turning this off also
  // reports in-file-only exports, which is a planned follow-up.
  "ignoreExportsUsedInFile": true,

  // mkfifo is a POSIX utility, not an npm dependency: the exec journal test
  // (packages/exec/src/journal-reconcile-run.test.ts) calls it to make a pipe.
  "ignoreBinaries": ["mkfifo"],

  "workspaces": {
    // Repo root. The repo scripts and the shared test helpers are entries, so
    // every module they import is reached. bin/kubic.js is an entry through the
    // root package.json "bin" field.
    ".": {
      "entry": ["scripts/*.mjs", "test/*.ts"],
      "project": ["**/*.ts", "**/*.mjs"]
    },
    // Packages are internal and have no entry point. Their tests are the
    // entries, so a symbol that only a test imports counts as used.
    "packages/*": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    // The app's entry is its composition root. Its tests are entries, as for
    // the packages.
    "apps/kubic": {
      "entry": ["src/main.ts", "**/*.test.ts"],
      "project": ["**/*.ts"]
    }
  }
}
