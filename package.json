{
  "name": "kubic",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Kubic — model-agnostic terminal coding agent",
  "bin": {
    "kubic": "bin/kubic.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "kubic": "node ./bin/kubic.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:binary": "node scripts/binary-contract.mjs && node scripts/faux-smoke.mjs",
    "release:stage": "node scripts/release-stage.mjs",
    "release:contract": "node scripts/pack-install-contract.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:deps && npm run lint:dead && npm run lint:dead:prod && npm run check:pins && npm run docs:check && npm run check:gates",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "biome ci .",
    "lint:deps": "node scripts/dep-lint.mjs",
    "lint:dead": "knip",
    "lint:dead:prod": "knip --config knip.production.jsonc --production",
    "check:pins": "node scripts/check-pinned-deps.mjs",
    "check:gates": "node --test \"scripts/*.test.mjs\"",
    "docs:check": "node scripts/check-docs-links.mjs && node scripts/gen-config-docs.mjs --check",
    "docs:config": "node scripts/gen-config-docs.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "knip": "6.38.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@commander-js/extra-typings": "15.0.0",
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2",
    "@earendil-works/pi-telemetry": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "commander": "15.0.0",
    "consola": "3.4.2",
    "lowlight": "3.3.0"
  }
}
