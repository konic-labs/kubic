// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`solo boot on the durable harness (issue #394) > assembles exactly the pre-1.0 prompt bytes in one untagged section 1`] = `
"You are a coding agent working in a terminal.
Use the read, write, edit, grep, find, ls, and bash tools to inspect and change files.
Keep answers short and technical.
cwd: /fake
tools: bash,edit,find,git_branch,git_checkpoint,git_commit,git_conflict_status,git_diff,git_log,git_merge,git_show,git_stage,git_status,git_worktree_list,grep,ls,read,write
meta: agent=root,lane=main,model=faux/big"
`;
