{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "reporters": ["progress", "clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "thresholds": { "high": 80, "low": 60, "break": null },
  "incremental": false,
  "incrementalFile": "reports/stryker-incremental.json",
  "concurrency": "50%",
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "disableBail": false,
  "ignoreStatic": true,
  "mutate": [
    "packages/trajectory/src/**/*.ts",
    "!packages/trajectory/src/**/*.test.ts",
    "packages/core/src/**/*.ts",
    "!packages/core/src/**/*.test.ts",
    "packages/exec/src/**/*.ts",
    "!packages/exec/src/**/*.test.ts",
    "packages/agents/src/**/*.ts",
    "!packages/agents/src/**/*.test.ts",
    "packages/worker/src/**/*.ts",
    "!packages/worker/src/**/*.test.ts",
    "packages/host/src/**/*.ts",
    "!packages/host/src/**/*.test.ts",
    "packages/eval/src/**/*.ts",
    "!packages/eval/src/**/*.test.ts",
    "packages/tui/src/**/*.ts",
    "!packages/tui/src/**/*.test.ts",
    "packages/host/src/doctor.ts",
    "packages/host/src/run-cli.ts",
    "apps/kubic/src/headless-run.ts",
    "packages/host/src/config/**/*.ts",
    "!packages/host/src/config/**/*.test.ts",
    "packages/extensions/src/**/*.ts",
    "!packages/extensions/src/**/*.test.ts",
    "packages/agents/src/skills/**/*.ts",
    "!packages/agents/src/skills/**/*.test.ts"
  ],
  "ignorePatterns": [
    "pi/**",
    "docs/design/**",
    "dist/**",
    "reports/**",
    ".beads/**",
    ".serena/**",
    ".claude/**"
  ],
  "plugins": ["@stryker-mutator/vitest-runner"],
  "dryRunTimeoutMinutes": 5
}
