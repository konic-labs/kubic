{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "scripts/dep-lint.test.mjs",
      "scripts/pi-boundary.test.mjs",
      "scripts/check-pinned-deps.test.mjs",
      "scripts/check-docs-links.test.mjs"
    ],
    "nodeArgs": ["--test-reporter=tap", "{{testFile}}"]
  },
  "coverageAnalysis": "perTest",
  "reporters": ["progress", "clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation-tap/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation-tap/index.html" },
  "thresholds": { "high": 80, "low": 60, "break": 80 },
  "incremental": false,
  "incrementalFile": "reports/stryker-tap-incremental.json",
  "concurrency": "50%",
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "disableBail": false,
  "ignoreStatic": false,
  "mutate": ["scripts/dep-lint.mjs", "scripts/check-pinned-deps.mjs"],
  "ignorePatterns": [
    "pi/**",
    "dist/**",
    "reports/**",
    ".beads/**",
    ".claude/**"
  ],
  "plugins": ["@stryker-mutator/tap-runner"],
  "dryRunTimeoutMinutes": 5
}
